# Solo para el script de importación del catálogo TCG (npm run catalogo).
# Copia este archivo a .env.catalogo (ya está en .gitignore) y llénalo con
# Project Settings → API de Supabase.
#
# ⚠️ La service_role / secret key se salta RLS. NUNCA la pongas en Netlify,
# en variables VITE_ ni en el código del frontend.
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key
