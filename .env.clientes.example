# Solo para administrar clientes (npm run clientes -- …).
# Copia este archivo a .env.clientes (ya está en .gitignore).
#
# Token personal de Supabase: https://supabase.com/dashboard/account/tokens
# ⚠️ Da acceso a TODOS tus proyectos. NUNCA en Netlify ni en variables VITE_.
SUPABASE_ACCESS_TOKEN=sbp_tu-token
# IDs de proyecto (project ref, el que aparece en la URL del dashboard) de
# cada cliente, separados por coma.
CLIENTES=abcdefghijklmnopqrst,uvwxyzabcdefghijklmn
