# Copia este archivo a .env.local. En kananpos.com el proyecto de cada cliente sale
# de src/tenants.json (por subdominio); estas variables solo aplican fuera del
# dominio (localhost, *.netlify.app). Solo la anon/publishable key: NUNCA la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Opcional: nombre del negocio para la pantalla de inicio de sesión en un equipo
# nuevo. Después de entrar, la app usa el de la base (tabla app_settings).
VITE_BUSINESS_NAME=
# Opcional, solo en local: simula estar en un cliente de src/tenants.json.
# VITE_TENANT=hachiko
