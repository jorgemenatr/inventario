# Copia este archivo a .env.local y llena los valores de tu proyecto de Supabase
# (Project Settings → API). Solo la anon/publishable key: NUNCA la service_role.
VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
# Opcional: nombre del negocio para la pantalla de inicio de sesión en un equipo
# nuevo. Después de entrar, la app usa el de la base (tabla app_settings).
VITE_BUSINESS_NAME=
